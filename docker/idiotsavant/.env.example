# Copy to .env and fill in. The .env file is not committed.

# API key. Clients send it as "Authorization: Bearer <key>". Default: idiotsavantftw.
#VLLM_API_KEY=
# Key for the admin routes (cache reset, admission control). Empty = VLLM_API_KEY.
#VLLM_ADMIN_API_KEY=

# Host paths (default: folders next to the compose file).
#MODELS_DIR=./models        # Hugging Face cache: the model and drafter are downloaded here
# Model and drafter: Hugging Face ids (downloaded on first start) or paths inside the container,
# e.g. /root/.cache/huggingface/qwen3.8_27b_idiotSavant_sm_86 for a copy already in MODELS_DIR.
#MODEL=BlairQ/qwen3.8_27b_idiotSavant_sm_86
#DRAFT_MODEL=BlairQ/qwen3.8_27b_idiotSavant_sm_86_dflash2
#CACHE_DIR=./cache          # JIT caches (torch.compile, Triton, PTX kernels)
#KV_DISK_DIR=./kv-offload   # only for the optional disk KV tier

# Host port and container memory limit.
#PORT=8000
#MEM_LIMIT=26g

# Only with docker-compose.network.yml:
#NET_NAME=my-network
#NET_IP=172.20.0.10
#CPUSET=0-7
