# Copy to .env and fill in. The .env file is not committed.

# API key. Clients send it as "Authorization: Bearer <key>". Default: idiotsavantftw.
#VLLM_API_KEY=
# Key for the admin routes (cache reset, admission control). Empty = VLLM_API_KEY.
#VLLM_ADMIN_API_KEY=

# Host paths (default: folders next to the compose file).
#MODELS_DIR=./models        # must contain qwen3.8_27b_idiotSavant_sm_86 and ..._dflash2
#CACHE_DIR=./cache          # JIT caches (torch.compile, Triton, PTX kernels)
#KV_DISK_DIR=./kv-offload   # only for the optional disk KV tier

# Host port and container memory limit.
#PORT=8000
#MEM_LIMIT=26g

# Only with docker-compose.network.yml:
#NET_NAME=my-network
#NET_IP=172.20.0.10
#CPUSET=0-7
